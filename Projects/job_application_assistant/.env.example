# Copy this file to .env and adjust values for your environment.

# --- Application ---
DEBUG=false

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Database (async asyncpg driver) ---
# Used when running the backend directly on your host.
DATABASE_URL=postgresql+asyncpg://jaa_user:jaa_pass@localhost:5432/job_application_assistant

# --- Postgres container (used by docker-compose) ---
# These configure the `db` service and are composed into the backend's
# DATABASE_URL automatically inside docker-compose.yml.
POSTGRES_USER=jaa_user
POSTGRES_PASSWORD=jaa_pass
POSTGRES_DB=job_application_assistant

# --- Authentication / JWT ---
JWT_SECRET=change-me-in-production-super-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# --- CORS (JSON array of allowed origins) ---
CORS_ORIGINS=["*"]

# --- LLM configuration ---
# The provider is "openai" (the only supported value), but because it talks to
# any OpenAI-COMPATIBLE endpoint, you can use free providers by setting
# LLM_API_BASE to their endpoint. The project does NOT require an OpenAI key.
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ---- Option A: Groq (cloud, free tier, fast) — recommended if no OpenAI key.
# Get a free key at https://console.groq.com/keys
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your-groq-api-key
LLM_API_BASE=https://api.groq.com/openai/v1

# ---- Option B: OpenAI (default). Uncomment and set your key.
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=your-openai-key
# (leave LLM_API_BASE unset for OpenAI)

# ---- Option C: Ollama (local, free, no key). Run `ollama serve` first.
# LLM_MODEL=llama3.1
# LLM_API_KEY=ollama
# LLM_API_BASE=http://localhost:11434/v1

# ---- Option D: OpenRouter (cloud, free-tier models).
# Get a key at https://openrouter.ai/keys
# LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
# LLM_API_KEY=your-openrouter-key
# LLM_API_BASE=https://openrouter.ai/api/v1
