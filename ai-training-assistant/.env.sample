# Get free API key from https://console.groq.com
GROQ_API_KEY=gsk_your-key-here

# Vector database backend: "chroma" (real vector DB, default) or "numpy"
# (legacy in-memory fallback). Both use the same local ONNX embeddings.
VECTOR_BACKEND=chroma

# --- Authentication (local bcrypt users; stand-in for enterprise SSO) ---
# Seeded into data/users.json on first run. Change these before any shared use.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
EMPLOYEE_USERNAME=employee
EMPLOYEE_PASSWORD=change-me-employee

# --- Per-user rate limiting ---
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
