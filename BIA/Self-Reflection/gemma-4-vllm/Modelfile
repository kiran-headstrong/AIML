FROM gemma4:e2b

# Reduce context window for faster inference on CPU
# 128K default uses far more RAM — 4096 is enough for most tasks
PARAMETER num_ctx 4096

# Use only physical cores (8 on i9), avoid hyperthreading overhead
PARAMETER num_thread 8

# Keep one layer on CPU (no GPU available)
PARAMETER num_gpu 0

# Recommended Gemma 4 sampling settings
PARAMETER temperature 1.0
PARAMETER top_p 0.95
PARAMETER top_k 64

# Disable thinking mode for faster responses
PARAMETER think false

SYSTEM "You are a helpful assistant."
